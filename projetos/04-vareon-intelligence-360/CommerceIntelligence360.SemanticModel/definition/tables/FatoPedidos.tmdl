table FatoPedidos
	lineageTag: 27858225-cea5-4c6c-8028-61743a152d72

	measure 'Receita Bruta' = SUM(FatoPedidos[ValorProdutos])
		formatString: "R$ "#,0.00
		lineageTag: 269805d4-16b6-4ee4-ad5e-a86d18cea546

	measure Pedidos = DISTINCTCOUNT(FatoPedidos[PedidoID])
		formatString: #,0
		lineageTag: 019a19f3-5414-4313-9601-d926da65659a

	measure 'Itens Vendidos' = SUM(FatoPedidos[Quantidade])
		formatString: #,0
		lineageTag: 33121802-f139-482c-b781-5bc9b773aaee

	measure 'Ticket Medio' = DIVIDE([Receita Bruta], [Pedidos])
		formatString: "R$ "#,0.00
		lineageTag: e3a2f6bc-8d1b-430f-af72-ddf98151673d

	measure 'Clientes Ativos' = DISTINCTCOUNT(FatoPedidos[ClienteID])
		formatString: #,0
		lineageTag: e4dc1170-789f-4ff2-8908-aae626b03394

	measure 'Frete Total' = SUM(FatoPedidos[ValorFrete])
		formatString: "R$ "#,0.00
		lineageTag: 36a5ae6c-c1cc-4209-a728-e913dba5fea7

	measure 'Custo dos Produtos' = SUM(FatoPedidos[CustoProdutos])
		formatString: "R$ "#,0.00
		lineageTag: eeb8dbf6-12d4-4df7-ac1f-dc8e9276ec0e

	measure 'Margem Bruta' = [Receita Bruta] - [Custo dos Produtos]
		formatString: "R$ "#,0.00
		lineageTag: cf1e4ed5-43a3-4b22-a56a-dd428259bc87

	measure 'Margem Bruta %' = DIVIDE([Margem Bruta], [Receita Bruta])
		formatString: 0.0%
		lineageTag: aa6c4022-415b-4494-8b38-1e8c08e4ad57

	measure 'Receita Ano Anterior' = CALCULATE([Receita Bruta], SAMEPERIODLASTYEAR(DimCalendario[Data]))
		formatString: "R$ "#,0.00
		lineageTag: 2595100c-053c-4412-89ea-e6b5793a43d2

	measure 'Variacao Receita YoY %' = DIVIDE([Receita Bruta] - [Receita Ano Anterior], [Receita Ano Anterior])
		formatString: 0.0%
		lineageTag: 57bba107-f54e-454b-9858-fe2651fdcb14

	measure 'Pedidos Entregues' = CALCULATE([Pedidos], FatoPedidos[Status] = "Entregue")
		formatString: #,0
		lineageTag: c5ecba24-0ce9-47a6-b594-4fd1e3b1e730

	measure 'Pedidos Cancelados' = CALCULATE([Pedidos], FatoPedidos[Status] = "Cancelado")
		formatString: #,0
		lineageTag: dc80c962-b4cd-4f3f-b616-3d3aff777e2f

	measure 'Taxa Cancelamento %' = DIVIDE([Pedidos Cancelados], [Pedidos])
		formatString: 0.0%
		lineageTag: 1a60d02b-1d82-4972-a2a7-b47b7ec08cfa

	measure 'Entregas no Prazo' = CALCULATE([Pedidos], FatoPedidos[StatusEntrega] = "No prazo")
		formatString: #,0
		lineageTag: 465ca7c0-daf8-43f3-ba03-1a699950d9e3

	measure 'Entregas Atrasadas' = CALCULATE([Pedidos], FatoPedidos[StatusEntrega] = "Atrasado")
		formatString: #,0
		lineageTag: 20ab0f3c-8482-4c2b-a9cd-0f25d5858dcf

	measure 'Entregas no Prazo %' = DIVIDE([Entregas no Prazo], [Pedidos Entregues])
		formatString: 0.0%
		lineageTag: 89437448-ae71-45b6-a918-ef4eca77dff9

	measure 'Entregas Atrasadas %' = DIVIDE([Entregas Atrasadas], [Pedidos Entregues])
		formatString: 0.0%
		lineageTag: f5d48471-a716-44a4-9934-73cbb3fb4af8

	measure 'Dias Medios Entrega' = AVERAGEX(FILTER(FatoPedidos, FatoPedidos[Status] = "Entregue"), FatoPedidos[DiasEntrega])
		formatString: 0.0
		lineageTag: 1b0564e3-48ae-4df7-a30e-9c39054c25d5

	measure 'Atraso Medio (dias)' = AVERAGEX(FILTER(FatoPedidos, FatoPedidos[DiasAtraso] > 0), FatoPedidos[DiasAtraso])
		formatString: 0.0
		lineageTag: b6b7ea77-6962-49df-a12c-98dc046a2dad

	measure 'Frete Medio' = DIVIDE([Frete Total], [Pedidos])
		formatString: "R$ "#,0.00
		lineageTag: f90d3587-76f0-4a48-8b39-316bc6f3906d

	measure 'Nota Media' = AVERAGE(FatoPedidos[NotaAvaliacao])
		formatString: 0.00
		lineageTag: caf0b5a9-71ca-4aa7-bc51-f7f631c46bed

	measure 'Avaliacoes Ruins' = CALCULATE([Pedidos], FatoPedidos[NotaAvaliacao] <= 2, FatoPedidos[Status] = "Entregue")
		formatString: #,0
		lineageTag: 88e67713-2833-40a3-9d70-dcbca75387e6

	measure 'Avaliacoes Ruins %' = DIVIDE([Avaliacoes Ruins], [Pedidos Entregues])
		formatString: 0.0%
		lineageTag: bd2dfadb-3cb4-4187-8163-54344c4e07f8

	measure 'Nota Media Atrasados' = CALCULATE([Nota Media], FatoPedidos[StatusEntrega] = "Atrasado")
		formatString: 0.00
		lineageTag: ed3ade02-c0b6-43fe-b820-46757a6aae8a

	measure 'Nota Media no Prazo' = CALCULATE([Nota Media], FatoPedidos[StatusEntrega] = "No prazo")
		formatString: 0.00
		lineageTag: 7f8fd2c2-e35d-48ec-99e4-d4f5f2a6a47f

	measure 'Receita com Atraso' = CALCULATE([Receita Bruta], FatoPedidos[StatusEntrega] = "Atrasado")
		formatString: "R$ "#,0.00
		lineageTag: d9dbde66-db3e-412e-98cd-b932335df038

	measure 'Receita com Atraso %' = DIVIDE([Receita com Atraso], [Receita Bruta])
		formatString: 0.0%
		lineageTag: 243cd0ae-58f4-4bb3-930e-534bae9410ae

	measure 'Clientes Recorrentes' = COUNTROWS(FILTER(VALUES(FatoPedidos[ClienteID]), CALCULATE([Pedidos]) >= 2))
		formatString: #,0
		lineageTag: 8e5fb49a-4cea-44eb-9e0b-ed214e00d550

	measure 'Clientes Recorrentes %' = DIVIDE([Clientes Recorrentes], [Clientes Ativos])
		formatString: 0.0%
		lineageTag: 3d82d6bf-6b79-46b9-89d9-3772d979773c

	measure 'Indice Experiencia' = DIVIDE([Nota Media], 5) * [Entregas no Prazo %]
		formatString: 0.0%
		lineageTag: ef98d638-2377-4d5e-bbe3-43f09e3c0a1d

	measure 'Meta Prazo %' = 0.85
		formatString: 0.0%
		lineageTag: eb4cdbaa-bd51-4f58-819a-6842e7eaf335

	measure 'Gap Prazo p.p.' = ([Entregas no Prazo %] - [Meta Prazo %]) * 100
		formatString: 0.0
		lineageTag: eeb77e1c-1adf-4c10-910e-172089963139

	measure 'Indice Criticidade' = [Entregas Atrasadas %] * [Avaliacoes Ruins %] * 100
		formatString: 0.00
		lineageTag: a6ef7f2f-6886-4354-8657-50d2c746765c

	measure 'Cor Categoria' = SWITCH( SELECTEDVALUE(DimProdutos[Categoria]), "Beleza", "#23C8C7", "Casa e Decoração", "#5A9CF4", "Eletrônicos", "#F4B56A", "Esportes", "#AA8BF1", "Livros", "#F07991", "Moda", "#7BC6A4", "Papelaria", "#D7A6EA", "#25DACD" )
		lineageTag: b06fd27f-8c5f-4deb-ac1c-f861d83c4194

	measure 'Cor Estado' = SWITCH( SELECTEDVALUE(DimClientes[Estado]), "BA", "#23C8C7", "CE", "#5A9CF4", "DF", "#F4B56A", "GO", "#AA8BF1", "MG", "#F07991", "PE", "#7BC6A4", "PR", "#D7A6EA", "RJ", "#A2C667", "RS", "#E6CE7A", "SC", "#6EBDD2", "SP", "#B7A0F1", "#25DACD" )
		lineageTag: dce438f3-aeb2-4869-884f-18331658c7ed

	measure 'Cor Segmento' = SWITCH( SELECTEDVALUE(DimClientes[Segmento]), "Novo", "#58A6FF", "Premium", "#9B89F8", "Recorrente", "#25DACD", "#25DACD" )
		lineageTag: 726f5add-63b0-47d5-83fa-cbba7f5336c0

	measure 'Cor Canal' = SWITCH( SELECTEDVALUE(FatoPedidos[Canal]), "Aplicativo", "#25DACD", "Marketplace", "#9B89F8", "Site", "#EAB86A", "#25DACD" )
		lineageTag: 11e73224-cd17-4d75-a813-702690504d15

	measure 'Cor Status Entrega' = SWITCH( SELECTEDVALUE(FatoPedidos[StatusEntrega]), "Atrasado", "#EF8796", "No prazo", "#25DACD", "Não entregue", "#AABCD2", "#25DACD" )
		lineageTag: 0c42d8e4-9f13-4de7-9b68-9ec92f10b793

	measure 'Cor Nota' = SWITCH( SELECTEDVALUE(FatoPedidos[NotaAvaliacao]), 1, "#EF8796", 2, "#E7A275", 3, "#EAB86A", 4, "#84C3BB", 5, "#25DACD", "#25DACD" )
		lineageTag: 323e9f92-11f1-47ed-9316-dbca3c90b4d2

	measure 'Cor Produto' = SWITCH( SELECTEDVALUE(DimProdutos[Categoria]), "Beleza", "#23C8C7", "Casa e Decoração", "#5A9CF4", "Eletrônicos", "#F4B56A", "Esportes", "#AA8BF1", "Livros", "#F07991", "Moda", "#7BC6A4", "Papelaria", "#D7A6EA", "#25DACD" )
		lineageTag: db2c25cc-d0b5-45d1-abe1-d18797fecce8

